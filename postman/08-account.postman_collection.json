    },
    {
      "name": "09 | Reject weak new password [422]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/changePassword",
        "description": "Actual Passay rules: 8\u201330 characters, at least one uppercase and digit, no whitespace. Error message incorrectly says maximum 20.\nExpected HTTP 422.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newPassword\": \"weak\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
