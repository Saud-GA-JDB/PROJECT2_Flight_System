{
  "info": {
    "name": "08 - Account - Profile passwords and deactivation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests top to bottom with the Presentation environment selected. Expected outcomes are source-derived; read PRESENTATION.md. State-changing examples create only identified demo records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 | Login as customer [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sauds.presentation.customer@mailsac.com\",\n  \"password\": \"DemoPassword1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save customerToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"customerToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Reject invalid phone [400]",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "http://localhost:8080/auth/users/updateProfile",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "value": "{\n  \"phoneNumber\": \"1\"\n}",
              "type": "text",
              "contentType": "application/json"
            },
            {
              "key": "image",
              "type": "file",
              "src": [],
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"Invalid phone\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Reject unpaired security question [400]",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "http://localhost:8080/auth/users/updateProfile",
