      ]
    },
    {
      "name": "13 | Complete setup and save customer ID [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/setup",
        "description": "Activates account, hashes password and security answer, saves customer profile and removes pending registration.\nExpected HTTP 200.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"DemoPassword1\",\n  \"fName\": \"Demo\",\n  \"lName\": \"Customer\",\n  \"phoneNumber\": \"36002002\",\n  \"phoneNumberOpeningCode\": \"+973\",\n  \"securityQuestion\": \"Birth city?\",\n  \"securityQuestionAnswer\": \"manama\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().id; pm.test(\"Save customerId\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"customerId\", value); }"
            ]
          }
        }
      ]
    },
