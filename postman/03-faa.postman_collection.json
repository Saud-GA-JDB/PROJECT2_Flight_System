{
  "info": {
    "name": "03 - FAA - Approve and deny airplanes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests top to bottom with the Presentation environment selected. Expected outcomes are source-derived; read PRESENTATION.md. State-changing examples create only identified demo records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{faaToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 | Login as faa [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"flighttest.faa@mailsac.com\",\n  \"password\": \"TestPassword1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save faaToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"faaToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | List pending requests [200]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/faaadmin/airplaneRequests",
        "description": "\nExpected HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Reject PENDING as review decision [400]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{requestId}}",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PENDING\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"ACCEPTED or DENIED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 | Reject denial without reason [400]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{requestId}}",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DENIED\",\n  \"reviewReason\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"reason is required\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 | Reject reason over 500 characters [400]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{requestId}}",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"reviewReason\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"500 characters\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 | Accept airplane [200]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{requestId}}",
        "description": "Marks request ACCEPTED and airplane ACTIVE, records reviewer/time, and sends email.\nExpected HTTP 200.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"reviewReason\": \"Presentation safety checks passed.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 | Reject reviewing twice [400]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{requestId}}",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACCEPTED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"already been reviewed\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 | Deny second airplane [200]",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/faaadmin/airplaneRequests/{{deniedRequestId}}",
        "description": "Denied airplane remains GROUNDED.\nExpected HTTP 200.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DENIED\",\n  \"reviewReason\": \"Presentation example: maintenance documents missing.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 | Reject activating active airplane [400]",
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/requestActivation",
        "description": "\nExpected HTTP 400.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"already active\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 | Reject resubmission within seven days [400]",
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{deniedAirplaneId}}/requestActivation",
        "description": "\nExpected HTTP 400.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"wait 7 days\"));"
            ]
          }
        }
      ]
    }
  ]
}
