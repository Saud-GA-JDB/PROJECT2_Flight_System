              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"before Departure\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 | Reject equal times [400]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/addFlight",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledDeparture\": \"{{departure}}\",\n  \"scheduledArrival\": \"{{departure}}\",\n  \"originAirportIataCode\": \"BAH\",\n  \"arrivalAirportIataCode\": \"DXB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
