{
  "info": {
    "name": "04 - Airline - Schedule flights",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests top to bottom with the Presentation environment selected. Expected outcomes are source-derived; read PRESENTATION.md. State-changing examples create only identified demo records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 | Login as admin [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sauds.presentation.admin@mailsac.com\",\n  \"password\": \"980100001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save adminToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"adminToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Reject missing airport [400]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/addFlight",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledDeparture\": \"{{departure}}\",\n  \"scheduledArrival\": \"{{arrival}}\",\n  \"originAirportIataCode\": \"\",\n  \"arrivalAirportIataCode\": \"DXB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"required fields\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Reject past departure [400]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/addFlight",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledDeparture\": \"2020-01-01T12:00:00\",\n  \"scheduledArrival\": \"{{arrival}}\",\n  \"originAirportIataCode\": \"BAH\",\n  \"arrivalAirportIataCode\": \"DXB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"future\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 | Reject unknown airport [400]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/addFlight",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledDeparture\": \"{{departure}}\",\n  \"scheduledArrival\": \"{{arrival}}\",\n  \"originAirportIataCode\": \"BAH\",\n  \"arrivalAirportIataCode\": \"ZZZ\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"valid arrival airport\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 | Reject arrival before departure [400]",
      "request": {
        "method": "POST",
        "header": [
          {
