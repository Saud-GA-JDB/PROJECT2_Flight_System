{
  "info": {
    "name": "06 - Flights - Search and validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests top to bottom with the Presentation environment selected. Expected outcomes are source-derived; read PRESENTATION.md. State-changing examples create only identified demo records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 | Login as customer [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sauds.presentation.customer@mailsac.com\",\n  \"password\": \"DemoPassword1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save customerToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"customerToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Search demo airline flights [200]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/flights/search?airlineCode=PX&originAirport=BAH&destinationAirport=DXB&seatType=standard&page=1&size=10&sort=scheduledDeparture,asc",
        "description": "Returns active flights on active airplanes with seats and departure over five minutes away. Other optional filters: date (yyyy-MM-dd), originCity, destinationCity, originCountry, destinationCountry.\nExpected HTTP 200."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Reject date=invalid [400]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/flights/search?date=invalid",
        "description": "\nExpected HTTP 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"valid date\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 | Reject date=2020-01-01 [400]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/flights/search?date=2020-01-01",
        "description": "\nExpected HTTP 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
