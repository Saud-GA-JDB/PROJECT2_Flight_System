            ]
          }
        }
      ]
    },
    {
      "name": "12 | Reject unauthenticated search [403]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/flights/search",
        "description": "Search is protected in the current security configuration.\nExpected HTTP 403.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}
