              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"future date\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 | Reject seatType=economy [400]",
      "request": {
        "method": "GET",
        "header": [],
