          "raw": "{\n  \"emailAddress\": \"sauds.presentation.admin@mailsac.com\",\n  \"cpr\": \"12\",\n  \"fName\": \"Demo\",\n  \"lName\": \"Admin\",\n  \"phoneNumberOpeningCode\": \"+973\",\n  \"phoneNumber\": \"36002001\",\n  \"hireDate\": \"2026-01-01\",\n  \"salary\": 1500,\n  \"securityQuestion\": \"Birth city?\",\n  \"securityQuestionAnswer\": \"manama\"\n}",
