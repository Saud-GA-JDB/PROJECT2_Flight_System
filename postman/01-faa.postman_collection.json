{
  "info": {
    "name": "01 - FAA - Airline and administrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests top to bottom with the Presentation environment selected. Expected outcomes are source-derived; read PRESENTATION.md. State-changing examples create only identified demo records."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{faaToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 | Login as faa [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"flighttest.faa@mailsac.com\",\n  \"password\": \"TestPassword1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save faaToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"faaToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Reject missing airline name [400]",
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://localhost:8080/faaadmin/airlines",
        "description": "Service rejects null or blank name, code or country before saving.\nExpected HTTP 400.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "name",
              "value": "",
              "type": "text"
            },
            {
              "key": "airlineCode",
              "value": "PX",
              "type": "text"
            },
            {
              "key": "headquartersCountry",
              "value": "Bahrain",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"required fields\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 | Create Presentation Airways [200]",
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://localhost:8080/faaadmin/airlines",
        "description": "Controller binds form parameters, not a JSON body. Airline name and code must each be unique.\nExpected HTTP 200.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "name",
              "value": "Presentation Airways",
              "type": "text"
            },
            {
              "key": "airlineCode",
              "value": "PX",
              "type": "text"
            },
            {
              "key": "headquartersCountry",
              "value": "Bahrain",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().id; pm.test(\"Save airlineId\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"airlineId\", value); }"
            ]
          }
        }
      ]
    },
