    {
      "name": "11 | FAA lookup - save airplane IDs [200]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8080/faaadmin/airlines",
        "description": "Creation response omits airplane ID. FAA airline listing exposes airplanesList with IDs; resolve by exact demo registration.\nExpected HTTP 200.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{faaToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {\nconst airline = pm.response.json().find(a => String(a.id) === String(pm.environment.get('airlineId')));\nfor (const [registration, key] of [['approvedRegistration','airplaneId'],['deniedRegistration','deniedAirplaneId']]) {\n const plane = airline && airline.airplanesList.find(p => p.registrationNumber === pm.environment.get(registration));\n pm.test('Find '+key, () => pm.expect(plane).to.be.an('object'));\n if (plane) pm.environment.set(key, plane.id);\n}\n}"
            ]
          }
        }
      ]
    },
    {
      "name": "12 | Reject flight on grounded airplane [400]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/airlineAdmin/airplanes/{{airplaneId}}/addFlight",
        "description": "\nExpected HTTP 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduledDeparture\": \"{{departure}}\",\n  \"scheduledArrival\": \"{{arrival}}\",\n  \"originAirportIataCode\": \"BAH\",\n  \"arrivalAirportIataCode\": \"DXB\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('departure')) {",
              " const d = new Date(); d.setUTCDate(d.getUTCDate()+7); d.setUTCHours(12,0,0,0);",
              " pm.environment.set('departure',d.toISOString().slice(0,19));",
              " pm.environment.set('arrival',new Date(d.getTime()+3600000).toISOString().slice(0,19));",
              " const n = new Date(); n.setUTCDate(n.getUTCDate()+1); n.setUTCHours(12,0,0,0);",
              " pm.environment.set('nearDeparture',n.toISOString().slice(0,19));",
              " pm.environment.set('nearArrival',new Date(n.getTime()+3600000).toISOString().slice(0,19));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Validation reason\", () => pm.expect(pm.response.text()).to.include(\"grounded\"));"
            ]
          }
        }
      ]
    },
