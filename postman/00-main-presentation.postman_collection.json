{
  "info": {
    "name": "00 - Main presentation - Complete flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "The short presentation flow in one collection. Select the Presentation environment and send requests top to bottom. Tokens and IDs are captured automatically. Pause after requesting verification email and enter verificationCode before continuing. Uses the same demo records as collections 01\u201309: choose either flow on a clean demo dataset; do not run both creation flows without cleanup."
  },
  "item": [
    {
      "name": "01 | Login as faa [200]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/auth/users/login",
        "description": "Authentication checks credentials and account state. JWT is returned in message and stored in the shared environment.\nExpected HTTP 200.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"flighttest.faa@mailsac.com\",\n  \"password\": \"TestPassword1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().message; pm.test(\"Save faaToken\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"faaToken\", value); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 | Create Presentation Airways [200]",
      "request": {
        "method": "POST",
        "header": [],
        "url": "http://localhost:8080/faaadmin/airlines",
        "description": "Controller binds form parameters, not a JSON body. Airline name and code must each be unique.\nExpected HTTP 200.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "name",
              "value": "Presentation Airways",
              "type": "text"
            },
            {
              "key": "airlineCode",
              "value": "PX",
              "type": "text"
            },
            {
              "key": "headquartersCountry",
              "value": "Bahrain",
              "type": "text"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{faaToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const value = pm.response.json().id; pm.test(\"Save airlineId\", () => pm.expect(value).to.not.equal(undefined)); if (value !== undefined) pm.environment.set(\"airlineId\", value); }"
            ]
          }
        }
      ]
    },
