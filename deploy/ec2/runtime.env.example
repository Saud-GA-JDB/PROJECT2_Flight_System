# Copy to runtime.env on the deployment host and chmod 600 that file.
# Fill every blank before starting; never commit the populated runtime.env.
IMAGE_TAG=
RDS_HOST=
APP_SCHEDULING_ENABLED=false
FRONTEND_ORIGINS=http://localhost:5173
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
IDENTITY_SERVICE_KEY=
NOTIFICATION_SERVICE_KEY=
MAINTENANCE_NOTIFICATION_SERVICE_KEY=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
